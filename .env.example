# Variables de la CENTRAL en Docker / Coolify (ver docs/DESPLIEGUE_COOLIFY.md).
# En Coolify se cargan en Environment Variables; este archivo es solo de referencia.

# Obligatorias
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
POSTGRES_PASSWORD=cambiar-por-una-contraseña-segura
ALLOWED_HOSTS=central.midominio.com
CSRF_TRUSTED_ORIGINS=https://central.midominio.com

# Primer arranque: crea el administrador si no existe
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiar
DJANGO_SUPERUSER_EMAIL=

# Opcionales
# POSTGRES_DB=gestion_de_carnicerias
# POSTGRES_USER=carnicerias
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=180
# DATA_UPLOAD_MAX_MEMORY_SIZE_MB=100
# Alternativa a la base del compose (PostgreSQL de Coolify):
# DATABASE_URL=postgres://usuario:clave@host:5432/base
