#: .\templates\admin_override\index.html:602
#, python-format
msgid "Saldo al cierre: <strong>$%(total)s</strong>."
msgstr ""

#: .\templates\admin_override\index.html:574
#, python-format
msgid ""
"El saldo <strong>aumentó $%(var)s</strong> respecto al inicio del período ($"
"%(ini)s). Esto significa que durante el período se generó más deuda nueva de "
"la que se cobró — la cartera está creciendo."
msgstr ""

#: .\templates\admin_override\index.html:576
#, python-format
msgid ""
"El saldo <strong>bajó $%(var)s</strong> respecto al inicio del período ($"
"%(ini)s). Se cobró más de lo que se fiaron — la cartera se está saneando."
