#, python-format
msgid "Saldo inicial: <strong>$%(total)s</strong>."
msgstr ""

#: .\templates\admin_override\index.html:560
#, python-format
msgid ""
"Comparándolo con el saldo al cierre (<strong>$%(fin)s</strong>), la cartera "
"de deuda <strong>creció</strong> $%(var)s durante el período (se fiaron más "
"de lo que se cobró)."
msgstr ""

#: .\templates\admin_override\index.html:561
#, python-format
msgid ""
"Comparándolo con el saldo al cierre (<strong>$%(fin)s</strong>), la cartera "
"de deuda <strong>se redujo</strong> $%(var)s durante el período (se cobró "
"más de lo que se fiaron)."
msgstr ""

#: .\templates\admin_override\index.html:562
#, python-format
msgid ""
"Comparándolo con el saldo al cierre (<strong>$%(fin)s</strong>), la cartera "
"de deuda no varió durante el período."
msgstr ""

#: .\templates\admin_override\index.html:570
msgid "Saldo clientes — cierre de período"
msgstr ""

#: .\templates\admin_override\index.html:571
#, python-format
msgid ""
"Es el monto total que deben los clientes al cierre del período, al "
"<strong>%(end_date_display)s</strong>. Representa toda la deuda pendiente "
"acumulada hasta esa fecha."
msgstr ""

